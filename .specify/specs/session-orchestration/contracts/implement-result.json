        "pr",
        "blocked",
        "failed"
      ]
    },
    "pr_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocked_on": {
      "enum": [
        "human:clarify",
        "human:plan-review",
        "human:merge",
        "ci",
        "conflict",
